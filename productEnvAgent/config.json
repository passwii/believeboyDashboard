{
  "skill": {
    "name": "deploy-vps",
    "description": "Deploys the BelieveBoy Dashboard to the production server (192.168.100.113)",
    "module": "deploy_vps.py",
    "entry_point": "main",
    "args_schema": {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "boolean",
          "description": "Preview commands without executing",
          "default": false
        },
        "auto_confirm": {
          "type": "boolean",
          "description": "Skip interactive prompts",
          "default": false
        }
      }
    }
  },
  "triggers": {
    "manual": {
      "enabled": true,
      "command": "/deploy-vps"
    },
    "on_git_push": {
      "enabled": false,
      "description": "Auto-deploy after pushing to origin/main",
      "branch": "main"
    },
    "on_commit": {
      "enabled": false,
      "description": "Auto-deploy after local commit with deploy keyword",
      "pattern": "deploy"
    }
  },
  "vps": {
    "host": "192.168.100.113",
    "user": "damon",
    "project_dir": "/home/damon/believeboyDashboard/",
    "backend_dir": "/home/damon/believeboyDashboard/backend/",
    "service_name": "believeboy-api"
  },
  "workflow": {
    "steps": [
      "cd /home/damon/believeboyDashboard/ && git pull",
      "cd backend/ && source .venv/bin/activate && alembic upgrade head",
      "systemctl stop believeboy-api",
      "systemctl start believeboy-api",
      "systemctl status believeboy-api --no-pager"
    ]
  },
  "logging": {
    "enabled": true,
    "dir": "logs/",
    "file_pattern": "deploy-{date}.log"
  }
}
