# Backend environment variables — example / template.
#
# `backend/.env` is the actual file used at runtime. This `.env.example`
# file is the checked-in template that documents every supported key and
# its default. Copy this to `.env` and fill in the values for local dev.
#
# Sensitive values (passwords, API keys) MUST stay out of `.env.example`.
# Anything listed here must be safe to commit.

# --- PostgreSQL ---------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=BLF
PGUSER=damon
# PGPASSWORD=replace-me

# Full SQLAlchemy URL consumed by both alembic/env.py and
# app.core.config.Settings.database_url. Required at app startup; if
# absent, alembic upgrade will fail with `database_url: Field required`
# and uvicorn will refuse to launch. Convention: build from PG* above.
# DATABASE_URL=postgresql+psycopg://<PGUSER>:<PGPASSWORD>@<PGHOST>:<PGPORT>/<PGDATABASE>

# Production database connection string — used by maintenance/ops scripts
# (backend/scripts/fix_ad_upload_status_and_logs.py,
# backend/scripts/test_schedule_remote*.py). No hardcoded IP fallback in
# source — scripts require this env var or they exit with a clear error.
# See [BEL-75].
# PROD_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Seed / ops scripts credentials ------------------------------------------
# Consumed by backend/scripts/seed_admin_user.py, init_user_accounts.py,
# backend-go/cmd/seedtestaccounts and backend/scripts/agent_testing/conftest.py.
# These scripts no longer ship a hardcoded password — they require the
# secrets below (or an explicit --password on the CLI). Copy this to your
# real backend/.env and fill in real values; keep them OUT of .env.example.
# ADMIN_SEED_PASSWORD=replace-me-with-the-admin-seed-password
# TEST_ACCOUNT_PASSWORD=replace-me-with-the-test-account-password
# TEST_ADMIN_PASSWORD=replace-me-with-the-agent-test-admin-password
# TEST_OPERATOR_PASSWORD=replace-me-with-the-agent-test-operator-password
# TEST_BUSINESSDEV_PASSWORD=replace-me-with-the-agent-test-businessdev-password

# --- Dedicated test database (BEL: test isolation) --------------------------
# When TEST_DATABASE_URL is set, the app, alembic migrations, and the whole
# test suite transparently use this separate Postgres DB instead of
# DATABASE_URL — so tests never touch the dev/prod database. The DB is
# persistent: create + migrate + seed it ONCE with
#   python scripts/setup_test_db.py
# (reads TEST_DATABASE_URL + the TEST_*_PASSWORD values below, and seeds the
# test admin / operator / businessdev accounts). Store these in the
# gitignored backend/.env.test so you don't export them in the shell.
# TEST_DATABASE_URL=postgresql+psycopg://<PGUSER>:<PGPASSWORD>@<PGHOST>:<PGPORT>/BLF_test
# Optional read-replica URL for the test DB (usually left blank — tests use primary).
# TEST_DATABASE_READ_URL=
# TEST_ADMIN_EMAIL=test_admin@believeboy.com
# TEST_OPERATOR_EMAIL=test_operator@believeboy.com
# TEST_BUSINESSDEV_EMAIL=test_businessdev@believeboy.com
# TEST_ADMIN_PASSWORD=replace-me-with-the-test-admin-password
# TEST_OPERATOR_PASSWORD=replace-me-with-the-test-operator-password
# TEST_BUSINESSDEV_PASSWORD=replace-me-with-the-test-businessdev-password

# --- BEL-55-P5 / BEL-73: read replica ----------------------------------------
# Optional. When set, read-only endpoints (and a few read-heavy background
# services) route to this database. When blank, all endpoints use
# DATABASE_URL (backward compatible — verified by BEL-73 验收 2).
#
# Notes:
# - The replica URL should use the same driver (postgresql+psycopg) and
#   the same database name as the primary.
# - PgBouncer users: in PR 3, this URL will point at PgBouncer on 6432;
#   the SQLAlchemy engine picks up its own pool, so PgBouncer's pool
#   multiplies with SQLAlchemy's. Tune DB_READ_POOL_SIZE accordingly.
# DATABASE_READ_URL=postgresql+psycopg://<PGUSER>:<PGPASSWORD>@<REPLICA_HOST>:<REPLICA_PORT>/<PGDATABASE>
# DB_READ_POOL_SIZE=20
# DB_READ_MAX_OVERFLOW=20
# After this many consecutive replica failures the circuit breaker opens
# and reads fall back to the primary until the cooldown elapses.
# REPLICA_FAILURE_THRESHOLD=5
# Seconds the breaker stays open before allowing a probe.
# REPLICA_COOLDOWN_SECONDS=30

# --- Frontend (CORS) ----------------------------------------------------------
# Required by app/main.py at startup. Comma-separated list of allowed
# origins is NOT supported here — set ONE origin (the dashboard URL).
# FRONTEND_URL=http://localhost:3000

# --- Resend Email (alerts) ----------------------------------------------------
# RESEND_API_KEY=re_replace_me
ALERT_FROM_EMAIL=alerts@believeboy.com
ALERT_FROM_NAME=BelieveBoy Dashboard

# --- Redis (broker + cache) ---------------------------------------------------
# Redis is shared between the API process (session/presence/cache) and the
# Celery worker (broker + result backend). CELERY_BROKER_URL and
# CELERY_RESULT_URL are auto-derived from REDIS_HOST/REDIS_PORT/REDIS_DB
# (broker uses db+1, result backend uses db+2) when left blank — set them
# explicitly only if the broker must live on a different Redis instance.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Celery worker ------------------------------------------------------------
# Auto-derived from REDIS_* when blank:
#   broker  -> redis://<REDIS_HOST>:<REDIS_PORT>/<REDIS_DB+1>
#   result  -> redis://<REDIS_HOST>:<REDIS_PORT>/<REDIS_DB+2>
# CELERY_BROKER_URL=
# CELERY_RESULT_URL=
# Local dev override. Production systemd unit believeboy-celery.service
# passes `--concurrency=2` directly (2026-07-29: down from 4 on the 1.9 GiB
# VPS to keep swap headroom). Bump this on a beefy dev box if you want more
# local task slots, but the value here is the fallback used by `celery -A ...
# beat` style invocations and the settings.celery_worker_concurrency default.
CELERY_WORKER_CONCURRENCY=4

# --- BEL-NEW: 定时报告迁移至 Celery (docs/superpowers/plans/2026-07-10) ----
# 是否在本 API 进程启动 APScheduler。多副本时仅一个副本设 true，其余设 false，
# 避免每分钟重复 delay() 同一份派发集合。搭配 SCHEDULED_REPORT_VIA_CELERY=
# false 也可暂停调度。
# ENABLE_SCHEDULER=true

# true（默认）：APScheduler 触发后将派发 delay() 进 broker，由 Celery worker
#   的 scheduled 队列执行（需要 belief-worker-scheduled.service 在线）。
# false：APScheduler 用 ThreadPoolExecutor 在 API 内同步跑（回滚形态，
#   代码层面 _dispatch_one / 旧分支不动，重启即恢复旧行为）。
# SCHEDULED_REPORT_VIA_CELERY=true

# 同一分钟触发的多个订阅错峰派发间隔（秒）。第 i 个订阅延后 i × SPREAD 秒
# （默认 60s：i=0/1/2... → 0s/60s/120s ……，11 个 daily 拉成 10 分钟错峰）。
# SCHEDULED_DISPATCH_SPREAD_SECONDS=60

# ai_summary Celery 队列的 LLM 并发信号量上限（与 generate_insight 的
# max_concurrent_insights 独立）。方案 §4.6 取 5：insights 占 3 路、ai_summary
# 额外允许 5 路、留 headroom 不撞 LLM provider RPM。
# MAX_CONCURRENT_AI_SUMMARY=5

# AI 摘要超时（秒）。置 0 表示关闭该频次的 AI 调用、直接使用 fallback 摘要。
# 日报频次默认关闭 AI（快速出结果，无需深入分析）；周报/月报保留 AI。
# AI_SUMMARY_TIMEOUT_SEC_DAILY=0
# AI_SUMMARY_TIMEOUT_SEC_WEEKLY=60
# AI_SUMMARY_TIMEOUT_SEC_MONTHLY=90

# --- Cloudflare R2 Storage ----------------------------------------------------
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PUBLIC_URL=

# --- PostgreSQL Backup (via pgBackRest → Cloudflare R2) -----------------------
# Plan: docs/superpowers/plans/2026-07-17-pg-r2-backup-feature/
# 备份异步化开关。true=API 端只 enqueue，Celery worker 跑（新形态）；
# false=API 端同步 subprocess.run（回滚兜底）。
# BACKUP_VIA_CELERY=true

# Celery task 软/硬时间限制（秒）。Phase 1 跑 pgbackrest info 历史 duration 后调。
# 默认 90/120 min 占位，需按实际 P99 调整。
# BACKUP_SOFT_TIME_LIMIT=5400
# BACKUP_HARD_TIME_LIMIT=7200

# R2 保留份数，超出由 Celery Beat 04:30 周期清理（与本地 retention-full=7 对齐）。
# BACKUP_R2_RETENTION_COUNT=7

# 自动备份小时（24h 制），Celery Beat crontab(hour=此值, minute=0)。默认凌晨 3:00。
# BACKUP_DAILY_SCHEDULE_HOUR=3

# --- Backend API to frontend --------------------------------------------------
# Shared with the frontend proxy (BACKEND_API_KEY in frontend/.env.local).
API_KEY=replace-me-with-a-long-random-string
UPLOAD_ROOT=./storage/uploads

# --- AI chat provider (server-side only) --------------------------------------
# AI_CHAT_PROVIDER_BASE_URL=https://api.believeboy.com/v1
# AI_CHAT_PROVIDER_API_KEY=replace-me
AI_CHAT_DEFAULT_MODEL=Believeboy-Nano
AI_CHAT_TITLE_MODEL=
AI_CHAT_MODEL_BLOCKLIST=GLM-5.2
AI_CHAT_PREMIUM_MODELS=MiniMax-M3,DeepSeek-V4-Pro
AI_CHAT_BASIC_MODELS=Believeboy-Nano,DeepSeek-V4-Flash

# --- Canonical Insight provider selection (server-side only) --------------------
# Clients may submit only endpoint/model ids from this registry; credentials,
# base URLs, and role instructions never leave the backend process.
# INSIGHT_DEFAULT_ENDPOINT_ID=default
# INSIGHT_ENDPOINT_IDS=default
# INSIGHT_DEFAULT_MODEL=
# INSIGHT_ROLE_DEFAULT_MODELS=schedule_report_summary.v1=Believeboy-Nano
# 供应商现役模型（代理 /v1/models，带 TTL 缓存）是否并入 Insight allowlist。
# 默认 true：UI 下拉与 chat 链路都取自该清单，只认静态 AI_CHAT_* 会漂移成
# MODEL_NOT_ALLOWED。置 false 回退纯静态 allowlist（回滚开关）。
# INSIGHT_ALLOW_PROVIDER_MODELS=true
# --- AI chat "thinking" / reasoning model selection ---------------------------
AI_CHAT_REASONING_MODELS=Believeboy-Nano,DeepSeek-V4-Flash,DeepSeek-V4-Pro,MiniMax-M3,qwen3.8-max-preview
AI_CHAT_DEFAULT_REASONING_EFFORT=medium

# --- AI chat web search -------------------------------------------------------
AI_CHAT_WEB_SEARCH_BASE_URL=https://search.believeboy.com
AI_CHAT_WEB_SEARCH_API_KEY=
AI_CHAT_WEB_SEARCH_TOPIC=general
AI_CHAT_WEB_SEARCH_DEPTH=advanced
AI_CHAT_WEB_SEARCH_MAX_RESULTS=10
