[Unit]
Description=Believeboy Celery background worker
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/believeboyDashboard/backend
EnvironmentFile=/root/believeboyDashboard/backend/.env
ExecStart=/root/believeboyDashboard/backend/.venv/bin/celery -A app.tasks.celery_app worker -l info -Q default,reports,insights,ai_summary --concurrency=2 --max-tasks-per-child=100
Restart=always
RestartSec=3

# 内存限制——主 worker 处理月报 / 洞察 / AI 摘要等 IO 密集任务，
# 不含 Chrome 截图（已隔离到 believeboy-celery-scheduled）。
# -c 2 双路并发峰值约 250-300 MB，512M 上限留有余量；
# 2026-07-29 由 -c 4 降到 -c 2：1.9 GiB VPS swap 已在用 (398Mi/1.0Gi)，
# 4 worker 子进程 ~150-160 MiB × 5 ≈ 800 MiB 吃紧；降到 2 后 ~500 MiB 留出余量。
MemoryMax=512M
MemoryHigh=384M
MemorySwapMax=128M

# 消费 default,reports,insights,ai_summary 四个队列。
# scheduled 队列由独立的 believeboy-celery-scheduled.service 消费，
# 实现 Chrome 截图任务的内存隔离（方案 §4.4）。
# --max-tasks-per-child=100 防止 fork worker 长期运行后内存膨胀不释放。
# 缩到 -c 2 后，如遇 default 队列任务堆积（积压 / 长尾 IO），优先调小 --max-tasks-per-child
# 复现 fork，而非直接升 -c——这条 VPS 内存太小是结构性约束。

[Install]
WantedBy=multi-user.target
