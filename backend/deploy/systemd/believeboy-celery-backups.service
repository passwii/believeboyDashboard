[Unit]
Description=Believeboy Celery backup worker (pgBackRest → Cloudflare R2, 方案 §3.5)
Documentation=https://github.com/passwii/believeboyDashboard/blob/main/docs/superpowers/plans/2026-07-17-pg-r2-backup-feature/2026-07-17-pg-r2-backup-feature-continuation.md
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/believeboyDashboard/backend
EnvironmentFile=/root/believeboyDashboard/backend/.env
ExecStart=/root/believeboyDashboard/backend/.venv/bin/celery \
          -A app.tasks.celery_app worker \
          -Q backups -c 1 --loglevel=info
Restart=always
RestartSec=3

# 该 worker 故意只消费 `backups` 队列（数据库备份任务），其他队列由
# `believeboy-celery.service` / `believeboy-celery-scheduled.service` 负责。
# `-c 1` 强制单并发：备份是 IO 重活（pgbackrest + tar + R2 上传），两个备份
# 同时跑会互相抢磁盘 IO；单进程也便于内存 / 句柄泄漏排查。
# run_backup_task 内部有行锁 + 乐观锁幂等护栏（方案 §3.2），即使误投也不会重复备份。

[Install]
WantedBy=multi-user.target
