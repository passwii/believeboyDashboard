[Unit]
Description=Believeboy Celery Flower monitoring UI (basic auth)
After=network.target
# Flower reads from the same broker as the worker — start it after the
# worker so the dashboard sees the worker's queues populated by the time
# the operator opens the UI.
After=believeboy-worker.service

[Service]
User=root
Group=root
WorkingDirectory=/root/believeboyDashboard/backend
EnvironmentFile=/root/believeboyDashboard/backend/.env
# FLOWER_PASSWORD must be set in /root/believeboyDashboard/backend/.env.
# The `flower_admin` username is the only operator account — keep it that
# way until we wire a per-user auth backend. The dashboard listens on
# 0.0.0.0:5555 and is fronted by a cloudflared tunnel (see
# backend/docs/multi-worker-ops.md for the tunnel hostname).
ExecStart=/root/believeboyDashboard/backend/.venv/bin/celery -A app.tasks.celery_app flower \
  --basic_auth=flower_admin:${FLOWER_PASSWORD} \
  --port=5555
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
