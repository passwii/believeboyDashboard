[Unit]
Description=Believeboy Celery Flower monitoring UI (basic auth)
After=network.target
# Flower reads from the same broker as the worker — start it after the
# worker so the dashboard sees the worker's queues populated by the time
# the operator opens the UI.
After=believeboy-worker.service

[Service]
User=damon
Group=damon
WorkingDirectory=/home/damon/believeboyDashboard/backend
EnvironmentFile=/home/damon/believeboyDashboard/backend/.env
# FLOWER_PASSWORD must be set in /home/damon/believeboyDashboard/backend/.env.
# The `flower_admin` username is the only operator account — keep it that
# way until we wire a per-user auth backend.
ExecStart=/home/damon/believeboyDashboard/backend/.venv/bin/celery -A app.tasks.celery_app flower \
  --basic_auth=flower_admin:${FLOWER_PASSWORD} \
  --port=5555
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
