[Unit]
Description=Believeboy Celery Flower monitoring UI (basic auth)
After=network.target
# Flower reads from the same broker as the worker — start it after the
# worker so the dashboard sees the worker's queues populated by the time
# the operator opens the UI.
After=believeboy-worker.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/believeboy/backend
EnvironmentFile=/opt/believeboy/backend/.env
# FLOWER_PASSWORD must be set in /opt/believeboy/backend/.env. The
# `flower_admin` username is the only operator account — keep it that
# way until we wire a per-user auth backend. The `--url_prefix=/flower`
# flag makes the UI mount under the nginx reverse proxy path described
# in backend/docs/multi-worker-ops.md (so /flower -> 127.0.0.1:5555).
ExecStart=/opt/believeboy/backend/.venv/bin/celery -A app.tasks.celery_app flower \
  --basic_auth=flower_admin:${FLOWER_PASSWORD} \
  --url_prefix=/flower \
  --port=5555
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
