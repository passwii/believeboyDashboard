[Unit]
Description=Believeboy FastAPI service
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/believeboyDashboard/backend
EnvironmentFile=/root/believeboyDashboard/backend/.env
MemoryMax=1G
ExecStart=/root/believeboyDashboard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --no-access-log --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
