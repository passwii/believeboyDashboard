[Unit]
Description=Believeboy FastAPI service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/believeboy/backend
EnvironmentFile=/opt/believeboy/backend/.env
ExecStart=/opt/believeboy/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
