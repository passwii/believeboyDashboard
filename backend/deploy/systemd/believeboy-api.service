[Unit]
Description=Believeboy FastAPI service
After=network.target

[Service]
User=damon
Group=damon
WorkingDirectory=/home/damon/believeboyDashboard/backend
EnvironmentFile=/home/damon/believeboyDashboard/backend/.env
ExecStart=/home/damon/believeboyDashboard/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
