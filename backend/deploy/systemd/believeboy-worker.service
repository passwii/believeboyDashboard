[Unit]
Description=Believeboy Celery background worker
After=network.target

[Service]
User=damon
Group=damon
WorkingDirectory=/home/damon/believeboyDashboard/backend
EnvironmentFile=/home/damon/believeboyDashboard/backend/.env
ExecStart=/home/damon/believeboyDashboard/backend/.venv/bin/celery -A app.tasks.celery_app worker -l info -Q default,reports,insights --concurrency=4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
