[Unit]
Description=Believeboy Celery background worker
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/believeboyDashboard/backend
EnvironmentFile=/root/believeboyDashboard/backend/.env
ExecStart=/root/believeboyDashboard/backend/.venv/bin/celery -A app.tasks.celery_app worker -l info -Q default,reports,insights,ai_summary --concurrency=2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
