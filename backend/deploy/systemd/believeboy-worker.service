[Unit]
Description=Believeboy Celery background worker
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/believeboyDashboard/backend
EnvironmentFile=/root/believeboyDashboard/backend/.env
ExecStart=/root/believeboyDashboard/backend/.venv/bin/celery -A app.tasks.celery_app worker -l info -Q default,reports,insights,ai_summary,scheduled --concurrency=1 --max-tasks-per-child=100
Restart=always
RestartSec=3

# 内存限制——合并后的 worker 需处理 Chrome 截图任务，384MB 覆盖单实例。
MemoryMax=384M
MemoryHigh=256M
MemorySwapMax=128M

# CPU 限制——2核 VPS 上 Chrome 截图曾打满双核导致级联故障（2026-07-28）。
# 150% = 最多用 1.5 核，留 0.5 核给 API/Redis/其他服务。
CPUQuota=150%
Nice=10

[Install]
WantedBy=multi-user.target
