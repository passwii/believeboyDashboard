[Unit]
Description=Believeboy Celery background worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/believeboy/backend
EnvironmentFile=/opt/believeboy/backend/.env
ExecStart=/opt/believeboy/backend/.venv/bin/celery -A app.tasks.celery_app worker -l info -Q default,reports,insights --concurrency=4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
