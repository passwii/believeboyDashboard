[Unit]
Description=Believeboy RQ worker service
After=network.target redis.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/believeboy/backend
EnvironmentFile=/opt/believeboy/backend/.env
ExecStart=/opt/believeboy/backend/.venv/bin/python -m worker.runner
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
