# Go Gateway listener.
GO_API_ADDR=127.0.0.1:8200
# FastAPI 已下线；该变量仅为满足网关配置校验保留，没有服务监听 8100。
FASTAPI_ORIGIN=http://127.0.0.1:8100
# 网关接管的模块。all（默认）= 全部 623 个 operation 都由 Go 处理；
# 也可以给一个短列表做灰度。未知模块名会让网关启动失败。
# Every owned module must pass the post-deploy owned-route smoke checks.
GO_API_OWNED=
# Opt-in example: health,exchange_rates,notifications,alerts,profile,crm_intent
# crm_intent imports archive batch files to R2; without R2 env both AI and
# manual imports fail closed with 503 INTENT_R2_UNAVAILABLE.
# Generate with: openssl rand -hex 32; match web.env exactly.
GO_API_TRUSTED_PROXY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
