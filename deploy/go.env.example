# Go Gateway listener and FastAPI fallback.
GO_API_ADDR=127.0.0.1:8200
FASTAPI_ORIGIN=http://127.0.0.1:8100
# Opt-in cutover only. Empty (default) = gateway proxies everything to FastAPI.
# Every owned module must pass the post-deploy owned-route smoke checks.
GO_API_OWNED=
# Generate with: openssl rand -hex 32; match web.env exactly.
GO_API_TRUSTED_PROXY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
