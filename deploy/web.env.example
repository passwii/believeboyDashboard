BACKEND_API_BASE_URL=https://dash-api.believeboy.com
# 8100 = FastAPI only (default, safe). Set to http://127.0.0.1:8200 only
# together with a non-empty GO_API_OWNED cutover in go.env.
BACKEND_INTERNAL_URL=http://127.0.0.1:8100
BACKEND_PUBLIC_API_BASE_URL=https://dash-api.believeboy.com
BACKEND_API_KEY=CHANGE_ME
# Server-only. Keep equal to GO_API_TRUSTED_PROXY_SECRET in go.env.
GO_API_TRUSTED_PROXY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
AUTH_SECRET=CHANGE_ME_SAME_AS_NEXTAUTH_SECRET
NEXTAUTH_URL=https://dash.believeboy.com
AUTH_URL=https://dash.believeboy.com
NEXT_PUBLIC_CRM_API_MODE=http
