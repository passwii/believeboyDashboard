# Copy to ~/.config/believeboy-dashboard/deploy.env and adjust if needed.
DEPLOY_HOST=guitar-vps
DEPLOY_PATH=/opt/believeboy-dashboard
DOMAIN=https://dash.believeboy.com
WEB_IMAGE_NAME=ghcr.io/passwii/believeboydashboard-web
API_IMAGE_NAME=ghcr.io/passwii/believeboydashboard-api
GO_API_IMAGE_NAME=ghcr.io/passwii/believeboydashboard-go-api
# Generate once with: openssl rand -hex 32
GO_API_TRUSTED_PROXY_SECRET=
# Go 切流显式 opt-in：默认空（Web 直连 FastAPI）。设置为如
# health,exchange_rates,notifications,alerts,profile,crm_intent 时必须同时设置
# GO_API_INTERNAL_URL=http://127.0.0.1:8200。
# 注意：GO_API_OWNED_MODULES 是 deploy-local.sh 的输入，脚本会写进 go.env 的
# GO_API_OWNED（网关唯一读取的变量名）；直接改 VPS go.env 时用 GO_API_OWNED。
# crm_intent 导入依赖 R2 环境变量（见 go.env.example），未配置时人工/AI 导入均 503。
# GO_API_OWNED_MODULES=
# GO_API_INTERNAL_URL=http://127.0.0.1:8200
# 2026-11-10 起部署冻结：只有 DEPLOYMENTS_ENABLED=true 才允许 git deploy。
# Go 后端全量迁移完成前只在本地 Docker 验证。
# DEPLOYMENTS_ENABLED=true
# 部署空间门槛（百分比默认 0 = 关闭；绝对下限默认 1 GiB / pull 后 512 MiB）
# DEPLOY_FREE_SPACE_MIN_BYTES=1073741824
# DEPLOY_FREE_SPACE_POST_PULL_MIN_BYTES=536870912
# DEPLOY_FREE_SPACE_PERCENT=0
# DEPLOY_PLATFORM=linux/amd64
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# GO_MODULE_PROXY=https://goproxy.cn,direct
# INTERNAL_AI_PROVIDER_BASE_URL=http://127.0.0.1:3100/v1
