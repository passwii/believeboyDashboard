// 项目级 AFT 覆盖：本仓库用 ESLint（非 biome），让 AFT 的 checker/formatter 复用项目实际工具链。
// 层级：用户级 ~/.config/cortexkit/aft.jsonc > 本文件(项目级) > 内置默认。
// 仅覆盖 checker/formatter，其余继承用户级配置。删除本文件即恢复全局 biome 偏好。
{
  "checker": {
    "typescript": "eslint",
    "javascript": "eslint"
  },
  "formatter": {
    "typescript": "eslint",
    "javascript": "eslint"
  }
}
