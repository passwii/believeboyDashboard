# ─── 运行环境设置 ───────────────────────────
# 可选值: local (本地) 或 production (远程生产环境)
# local:    使用 localhost 数据库 + API, 不移动文件到 processed/
# production: 使用远程数据库 + API, 处理完成后移动文件到 processed/
AUTO_REPORT_ENV=local

# ─── 数据库连接 (会被 config.py 根据 AUTO_REPORT_ENV 自动选择) ───
# local 环境默认: postgresql+psycopg://damon:jrway2012@localhost:5432/BLF
# production 环境默认: postgresql+psycopg://damon:jrway2012@145.79.143.98:5432/BLF
# 以下变量可以覆盖默认值:
# DATABASE_URL=postgresql+psycopg://damon:jrway2012@145.79.143.98:5432/BLF
# PGHOST=145.79.143.98
# PGPORT=5432
# PGDATABASE=BLF
# PGUSER=damon
# PGPASSWORD=jrway2012

# ─── 后端 API 地址 (会被 config.py 根据 AUTO_REPORT_ENV 自动选择) ───
# local 环境默认: http://127.0.0.1:8000
# production 环境默认: http://145.79.143.98:8000
# BACKEND_API_BASE=http://145.79.143.98:8000

# ─── 数字员工认证 ───────────────────────────
API_KEY=
DIGITAL_EMPLOYEE_ID=3
DIGITAL_EMPLOYEE_SECRET=
