# FastAPI backend (server-side only; frontend does not connect to Postgres directly)
BACKEND_API_BASE_URL=http://127.0.0.1:8000
BACKEND_API_KEY=replace_with_backend_api_key

# NextAuth
# IMPORTANT: In production, set this to your real domain, e.g. https://dashboard.yourdomain.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
