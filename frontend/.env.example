# Direct PostgreSQL connection (for migrations/import scripts)
DATABASE_URL=postgresql://user:password@localhost:5432/database
PGHOST=localhost
PGPORT=5432
PGDATABASE=BLF
PGUSER=damon
PGPASSWORD=replace_with_db_password

# FastAPI backend
BACKEND_API_BASE_URL=http://127.0.0.1:8000
BACKEND_API_KEY=replace_with_backend_api_key

# AI chat provider (server-side only, used by /dashboard/ai-panel/chat)
AI_CHAT_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_CHAT_PROVIDER_API_KEY=replace_with_llm_api_key
AI_CHAT_DEFAULT_MODEL=gpt-4o-mini
AI_CHAT_MODEL_ALLOWLIST=gpt-4o-mini,gpt-4.1-mini,gpt-4.1
AI_CHAT_TIMEOUT_SECONDS=90

# NextAuth
# IMPORTANT: In production, set this to your real domain, e.g. https://dashboard.yourdomain.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
