{
  "name": "believeboy-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "pnpm gen:api-types:check && next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api-types": "node scripts/gen-api-types.mjs",
    "gen:api-types:check": "node scripts/gen-api-types.mjs --check",
    "test:ui": "playwright test",
    "test:ui:ui": "playwright test --ui",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "perf:lhci": "lhci autorun --config=./.lighthouserc.json",
    "perf:lhci:collect": "lhci collect --config=./.lighthouserc.json",
    "perf:lhci:assert": "lhci assert --config=./.lighthouserc.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
