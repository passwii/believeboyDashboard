{
  "//_comment_purpose": "Lighthouse CI config — see /docs/perf-baseline-2026-06.md for baseline numbers and the threshold formula. Thresholds below are the INITIAL values computed from the 2026-06-12 baseline (max-median of 3 runs × 3 routes) per the formula initial = max(baseline * 1.2, target * 0.9). Do not relax a threshold that already passes without a written justification in the baseline doc.",
  "//_comment_threshold_formula": "initial_threshold = max(baseline * 1.2, target * 0.9). Target values from BEL-39: lcp<2.5s, tbt<200ms, total-byte-weight<1.2MB. Update asserts after Step B completes; do not relax a threshold that already passes without a written justification in the baseline doc.",
  "//_comment_targets": {
    "lcp_ms_target": 2500,
    "tbt_ms_target": 200,
    "total_byte_weight_kb_target": 1200,
    "fcp_ms_target": 1800,
    "cls_target": 0.1,
    "tti_ms_target": 3800
  },
  "//_comment_baseline_2026_06_12": {
    "source": "lhci autorun 3 routes × 3 runs on commit 2571b9f (post BEL-33..BEL-38 merge). See frontend/docs/perf-baseline-2026-06.md.",
    "per_route_medians_ms_or_units": {
      "/dashboard":                         { "fcp": 291,  "lcp": 1554, "tbt": 0,    "cls": 0.1576, "tti": 1555, "tbw_kb": 1246, "perf": 0.90 },
      "/dashboard/data-analysis/ad-analysis/overview": { "fcp": 297,  "lcp": 1056, "tbt": 0,    "cls": 0.0165, "tti": 1056, "tbw_kb":  799, "perf": 0.98 },
      "/dashboard/data-reporting/monthly-report":      { "fcp": 289,  "lcp":  818, "tbt": 0,    "cls": 0.0000, "tti":  818, "tbw_kb":  649, "perf": 1.00 }
    },
    "aggregated_for_threshold": {
      "lcp_ms_baseline_max": 1554,
      "tbt_ms_baseline_max": 0,
      "fcp_ms_baseline_max": 297,
      "cls_baseline_max": 0.1576,
      "tti_ms_baseline_max": 1555,
      "tbw_kb_baseline_max": 1246,
      "perf_baseline_min": 0.90
    }
  },
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "serverStartupTimeout": 60000,
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "is-on-https"]
      },
      "url": [
        "http://localhost:3200/dashboard",
        "http://localhost:3200/dashboard/data-analysis/ad-analysis/overview",
        "http://localhost:3200/dashboard/data-reporting/monthly-report"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.86 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2300 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.19 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1700 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1500000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
