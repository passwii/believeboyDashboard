# FastAPI backend
BACKEND_API_BASE_URL=http://localhost:8100
#BACKEND_API_BASE_URL=https://dashapi.believeboy.com
BACKEND_API_KEY=xxxx

NEXTAUTH_URL=http://localhost:3200
NEXTAUTH_SECRET=xxxx

# CRM 数据源：http=真实后端（Postgres）；未设置/其他=mock（浏览器 localStorage）
#NEXT_PUBLIC_CRM_API_MODE=http

# CRM mock 模式是否灌入演示夹具（100 客户 / 50 线索等，BLF-1372）
# 生产构建默认关闭：只显示你自己新建 / 导入的数据；开发与测试环境默认开启。
# 1=强制开启（预览环境演示用） 0=强制关闭
#NEXT_PUBLIC_CRM_DEMO_DATA=0
